---
interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={["treatment-card", className]} {...rest}>
  <slot />
</div>

<style>
  .treatment-card {
    margin: 0.2em;
    padding: 0.2em;
    border: var(--tile-border);
    background-color: var(--color-surface);
  }
</style>
