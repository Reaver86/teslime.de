---
import { Image } from "astro:assets";

import SectionAnchor from "../SectionAnchor.astro";

import review1Image from "../../images/rezension-1.webp";
import review2Image from "../../images/rezension-2.webp";
import review3Image from "../../images/rezension-3.webp";
import review4Image from "../../images/rezension-4.webp";
---

<SectionAnchor id="scroll-rezensionen" />
<section class="reviews" aria-label="Google-Rezensionen">
  <Image src={review1Image} alt="Google-Bewertung: 4,8 Sterne bei 46 Rezensionen und Rezension von Beyza Butun" />
  <Image src={review2Image} alt="Google-Rezensionen von Annette Flaig und Gabi S." />
  <Image src={review3Image} alt="Google-Rezension von Anna „Annalina“" />
  <Image src={review4Image} alt="Google-Rezension von Claudia Kaiser" />
</section>

<style>
  .reviews {
    max-width: 650px;
    margin-inline: auto;
    padding: 20px;
  }

  .reviews :global(img) {
    width: 100%;
    height: auto;
  }

  .reviews :global(img + img) {
    margin-top: 10px;
  }
</style>
