---
import { Image } from "astro:assets";

import { treatments } from "../../data/prices";

import FacialTreatmentCard from "./FacialTreatmentCard.astro";
import ImageGallery from "../ImageGallery.astro";
import TreatmentMeta from "../TreatmentMeta.astro";

import classicTreatment1Image from "../../images/gesichtsbehandlung-1.png";
import classicTreatment2Image from "../../images/gesichtsbehandlung-2.png";
import classicTreatment3Image from "../../images/gesichtsbehandlung-3.png";
import hydraFaceAnnouncementImage from "../../images/hydra-face-oktober-2026.jpeg";
import hydraFaceAfterImage from "../../images/hydra-face-nachher.webp";
import hydraFaceBeforeImage from "../../images/hydra-face-vorher.webp";
---

<FacialTreatmentCard>
  <Image
    class="hydra-poster"
    src={hydraFaceAnnouncementImage}
    alt="Seit Oktober 2026: neues 10-in-1-Hydra-Face-Gerät mit Hydra-Dermabrasion, Kalt-/Warm-Hammer, Sauerstoff, Ultraschall, Radiofrequenz, Skin-Scrubber, Augen-RF-Lifting, Desinfektion, EMS und LED-Lichttherapie"
    widths={[390, 700, 1055]}
    sizes="(max-width: 699px) 90vw, 700px"
  />

  <h3>Hydra-Face-Luxusbehandlung</h3>
  <TreatmentMeta {...treatments.hydraFace} />

  <h4>Inhalt der Hydra-Face Behandlung by Teslime</h4>
  <ul class="checklist">
    <li>Vorbereitung, manuelle Gesichtsreinigung</li>
    <li>Bedampfung</li>
    <li>Skin-Scrubber (28.000 Vibrationen/Sek.). Hautglättung, Entfernen von abgestorbenen Hautzellen und Unreinheiten</li>
    <li>Je nach Bedarf zusätzlich manuelle Ausreinigung</li>
    <li>Hydra-Reinigung, Hydra-Dermabrasion, Beseitigung von Verhornungen (Wirkstoff S1)</li>
    <li>Hydro Fruit Acid Peeling (Wirkstoff S2)</li>
    <li>Hyaluron Booster (Wirkstoff S3)</li>
    <li>Bipolare Radiofrequenzbehandlung (6 MHz). Hautstraffung und Faltenverringerung</li>
    <li>Augen-RF-Lifting (0,5–1 MHz). Stimulation von Kollagenwachstum</li>
    <li>Ultraschall. Wirkstoffeinschleusung</li>
    <li>Kalt-/Heiß-Hammer (0–47 °C einstellbar). Porenschließung und Beruhigung der Haut</li>
    <li>Oxigen-Spray-Gun. Feiner Sprühnebel für intensive Feuchtigkeit</li>
    <li>
      Wirkstoffeinschleusung mit Nanokristall-Chip und EMS.
      <p>Wirkstoffe: Lachs-DNA-Complex. Lachs-DNA ist der absolute Profi-Tipp zur Geweberegeneration. Sie repariert beschädigte Hautstrukturen und regt die hauteigene Kollagenbildung massiv an. Bringt müde, fahle Haut (z. B. Raucherhaut) sofort wieder zum Strahlen.</p>
      <p>Oder Botanical Stem Cell, maximale Hautstraffung und Faltenglättung: Es regt die Zellerneuerung reifer Haut tiefenwirksam an und gibt schlaffem Gewebe seine Spannkraft zurück.</p>
    </li>
    <li>
      LED-Lichttherapie plus Hyaluronmaske
      <ul>
        <li>Rotes Licht fördert die Kollagenregeneration und wirkt Anti-Aging.</li>
        <li>Grünes Licht verbessert Rötungen und Pigmentierung.</li>
        <li>Blaues Licht beseitigt Bakterien und repariert geschädigte Haut.</li>
        <li>Weißes Licht beschleunigt den Gewebestoffwechsel und verbessert feine Linien.</li>
      </ul>
    </li>
    <li>Abschlusspflege/-massage</li>
  </ul>

  <h4>Ergebnis:</h4>
  <ul class="checklist">
    <li>Glow-Effekt: saubere plus strahlende Haut für mehrere Wochen</li>
    <li>Regelmäßige Behandlung alle zwei Monate führt zu frischer, strahlender, gesunder Haut.</li>
  </ul>
  <p>Die Wirkstoffe S1, S2 und S3 sind von Wellcotec, vollständig in Deutschland hergestellt, vegan und frei von Tierversuchen, kein Konzentrat – absolut hochwertig und wirksam.</p>

  <p class="underlined">Ergebnisbeispiel:</p>
  <ImageGallery>
    <Image
      src={hydraFaceBeforeImage}
      alt="Hydra-Face vor der Anwendung"
      width={768}
      height={1024}
    />
    <Image
      src={hydraFaceAfterImage}
      alt="Hydra-Face nach der Anwendung – sichtbar strahlendere Haut"
      width={768}
      height={860}
    />
  </ImageGallery>

  <h3>Klassische Kosmetikbehandlung</h3>
  <TreatmentMeta {...treatments.classicFacial} />

  <div class="classic-examples">
    <Image src={classicTreatment1Image} alt="Beispiel einer Gesichtsbehandlung" />
    <Image src={classicTreatment2Image} alt="Beispiel einer Gesichtsbehandlung" />
    <Image src={classicTreatment3Image} alt="Beispiel einer Gesichtsbehandlung" />
  </div>

  <p>
    Hals-, Gesichts- und Dekolletébehandlung mit individuell auf Ihre Haut abgestimmten
    Spezialprodukten, inkl. Wirkstoffampulle und Augenpackung/-maske.
  </p>
  <ul>
    <li>Nackenmassage</li>
    <li>Reinigungsmassage</li>
    <li>Hautanalyse</li>
    <li>Intensivpeeling</li>
    <li>Bedampfung</li>
    <li>Behandlung von Hautunreinheiten</li>
    <li>Augenbrauenkorrektur</li>
    <li>Wirkstoffampulle oder Serum</li>
    <li>Gesichts-, Hals- und Dekolletémassage</li>
    <li>Packung/Maske</li>
    <li>Abschlusspflege</li>
  </ul>
</FacialTreatmentCard>

<FacialTreatmentCard>
  <h3>Intensiv-Gesichtsreinigung</h3>
  <TreatmentMeta {...treatments.deepCleansing} />
  <ul>
    <li>Reinigungsmassage</li>
    <li>Intensivpeeling</li>
    <li>Bedampfung</li>
    <li>Behandlung von Hautunreinheiten</li>
    <li>Ampulle</li>
    <li>Abschlusspflege</li>
  </ul>
</FacialTreatmentCard>

<style>
  .hydra-poster {
    display: block;
    width: 100%;
    max-width: 700px;
    margin: 0 auto 1.5em;
  }

  .classic-examples {
    margin-top: 1em;
  }
</style>
