---
type Variant = "standard" | "facelift" | "microneedling" | "laser" | "foot-care";

interface Props {
  variant?: Variant;
}

const { variant = "standard" } = Astro.props;
---

<div class:list={["image-gallery", `image-gallery--${variant}`]}>
  <slot />
</div>

<style>
  .image-gallery {
    display: grid;
    gap: 10px;
    justify-items: center;
    padding: 5px;
  }

  .image-gallery--standard {
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr));
  }

  .image-gallery--standard :global(img) {
    max-width: min(250px, 100%);
  }

  .image-gallery--facelift {
    grid-template-columns: 1fr 2fr 1fr;
    max-width: 800px;
    margin-inline: auto;
  }

  .image-gallery--facelift :global(img),
  .image-gallery--microneedling :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-gallery--microneedling {
    grid-template-columns: 1fr;
    max-width: 700px;
    margin-inline: auto;
  }

  .image-gallery--microneedling :global(img:nth-of-type(2)) {
    max-width: 300px;
  }

  .image-gallery--microneedling :global(img:last-of-type) {
    max-width: 200px;
  }

  .image-gallery--laser {
    display: flex;
    align-items: center;
    justify-content: space-around;
    height: 200px;
  }

  .image-gallery--laser :global(img) {
    width: 30%;
  }

  .image-gallery--laser :global(img:nth-child(1)) {
    max-width: 120px;
  }

  .image-gallery--laser :global(img:nth-child(2)) {
    max-width: 130px;
  }

  .image-gallery--laser :global(img:nth-child(3)) {
    display: none;
    max-width: 300px;
  }

  .image-gallery--laser :global(img.is-seasonal-visible) {
    display: block;
  }

  .image-gallery--foot-care {
    grid-template-columns: 1fr 1fr;
  }

  .image-gallery--foot-care :global(figure) {
    margin: 1em min(40px, 4vw);
  }

  .image-gallery--foot-care :global(img) {
    width: 95%;
    max-width: 300px;
  }

  @media (min-width: 495px) {
    .image-gallery--standard {
      grid-template-columns: 1fr 1fr;
    }

    .image-gallery--standard :global(img:nth-of-type(2n)) {
      justify-self: start;
    }

    .image-gallery--standard :global(img:nth-of-type(2n + 1)) {
      justify-self: end;
    }

    .image-gallery--microneedling {
      grid-template-columns: 2fr 1fr;
    }

    .image-gallery--microneedling :global(img:first-of-type) {
      grid-column: span 2;
    }
  }

  @media (min-width: 1200px) {
    .image-gallery--standard :global(img) {
      max-width: min(300px, 100%);
    }
  }
</style>
